# Curb Energy API Configuration
# Copy this file to .env and fill in your credentials

# Your Curb account credentials
CURB_USERNAME=your_curb_username
CURB_PASSWORD=your_curb_password

# OAuth2 Application Credentials
# You must obtain these from Curb support
# See: http://docs.energycurb.com/authentication.html
CURB_CLIENT_TOKEN=your_oauth_client_token
CURB_CLIENT_SECRET=your_oauth_client_secret

# Optional: API Server Configuration
# CURB_API_URL=https://app.energycurb.com
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
